<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>PSGraphView.PowerShell</RootNamespace>
    <CopyLocalLockFileAssemblies>true</CopyLocalLockFileAssemblies>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.PowerShell.SDK" Version="7.5.1" />
    <PackageReference Include="PSGraph.Common" Version="2.5.0-beta3" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../PSGraphView.Dsm/PSGraphView.Dsm.csproj" />
    <ProjectReference Include="../PSGraphView.Msagl/PSGraphView.Msagl.csproj" />
    <ProjectReference Include="../PSGraphView.Sfdp/PSGraphView.Sfdp.csproj" />
    <ProjectReference Include="../PSGraphView.Vega/PSGraphView.Vega.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="../PSGraphView.Vega/Assets/**/*.*">
      <Link>Assets\%(RecursiveDir)%(Filename)%(Extension)</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="en-US/**/*.*">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <None Update="PSGraphView.psd1">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

  <Target Name="CopySkiaNativeLibrariesToModuleRoot" AfterTargets="Build;Publish">
    <ItemGroup>
      <BuildSkiaNativeLibrary Include="$(TargetDir)runtimes/*/native/*SkiaSharp*" />
      <PublishSkiaNativeLibrary Include="$(PublishDir)runtimes/*/native/*SkiaSharp*" Condition="'$(PublishDir)' != ''" />
    </ItemGroup>
    <Copy SourceFiles="@(BuildSkiaNativeLibrary)" DestinationFolder="$(TargetDir)" SkipUnchangedFiles="true" Condition="'@(BuildSkiaNativeLibrary)' != ''" />
    <Copy SourceFiles="@(PublishSkiaNativeLibrary)" DestinationFolder="$(PublishDir)" SkipUnchangedFiles="true" Condition="'$(PublishDir)' != '' and '@(PublishSkiaNativeLibrary)' != ''" />
  </Target>

</Project>

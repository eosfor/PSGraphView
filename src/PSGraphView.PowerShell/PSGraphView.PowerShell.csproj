<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>PSGraphView.PowerShell</RootNamespace>
    <CopyLocalLockFileAssemblies>true</CopyLocalLockFileAssemblies>
    <IncludeGraphvizRuntimeBundle Condition="'$(IncludeGraphvizRuntimeBundle)' == ''">false</IncludeGraphvizRuntimeBundle>
    <GraphvizRuntimeRepository Condition="'$(GraphvizRuntimeRepository)' == ''">eosfor/graphviz-psgv</GraphvizRuntimeRepository>
    <GraphvizRuntimeVersion Condition="'$(GraphvizRuntimeVersion)' == ''"></GraphvizRuntimeVersion>
    <GraphvizRuntimeToken Condition="'$(GraphvizRuntimeToken)' == ''">$(PSGRAPHVIEW_GITHUB_TOKEN)</GraphvizRuntimeToken>
    <GraphvizRuntimeToken Condition="'$(GraphvizRuntimeToken)' == ''">$(GITHUB_TOKEN)</GraphvizRuntimeToken>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.PowerShell.SDK" Version="7.5.1" />
    <PackageReference Include="PSGraph.Common" Version="2.5.0-beta3" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../PSGraphView.Dsm/PSGraphView.Dsm.csproj" />
    <ProjectReference Include="../PSGraphView.Graphviz/PSGraphView.Graphviz.csproj" />
    <ProjectReference Include="../PSGraphView.Msagl/PSGraphView.Msagl.csproj" />
    <ProjectReference Include="../PSGraphView.Vega/PSGraphView.Vega.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="../PSGraphView.Vega/Assets/**/*.*">
      <Link>Assets\%(RecursiveDir)%(Filename)%(Extension)</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <None Update="PSGraphView.psd1">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

  <Target Name="StageGraphvizRuntimeBundle" AfterTargets="Publish" Condition="'$(IncludeGraphvizRuntimeBundle)' == 'true'">
    <Error Condition="'$(GraphvizRuntimeVersion)' == ''" Text="GraphvizRuntimeVersion must be set when IncludeGraphvizRuntimeBundle=true." />
    <PropertyGroup>
      <GraphvizRuntimeDestinationDirectory>$([System.Text.RegularExpressions.Regex]::Replace('$(PublishDir)', '[\\/]+$', ''))</GraphvizRuntimeDestinationDirectory>
    </PropertyGroup>
    <Exec
      Command="pwsh -NoLogo -NoProfile -File &quot;$(MSBuildProjectDirectory)/../../eng/Install-GraphvizRuntimeBundle.ps1&quot; -Repository &quot;$(GraphvizRuntimeRepository)&quot; -Version &quot;$(GraphvizRuntimeVersion)&quot; -DestinationDirectory &quot;$(GraphvizRuntimeDestinationDirectory)&quot;"
      EnvironmentVariables="PSGRAPHVIEW_GITHUB_TOKEN=$(GraphvizRuntimeToken)" />
  </Target>

</Project>
